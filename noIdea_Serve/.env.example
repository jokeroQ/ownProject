# Copy to .env and fill in once. Existing environment variables take priority.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=noIdea
DB_USER=root
DB_PASSWORD='replace-with-your-local-mysql-password'
# PORT=3000

# Optional: use an existing HTTP(S) proxy for sources unavailable on direct connections.
# Defaults to Bangumi only; do not change system proxy settings.
# SERIES_PROXY_URL=http://127.0.0.1:17890
# SERIES_PROXY_HOSTS=api.bgm.tv,lain.bgm.tv

# Optional collector proxy host allowlist (does not override robots/access rules).
# SERIES_COLLECTOR_PROXY_HOSTS=www.netflix.com,www.youku.com
# Only after verifying an authorized source: exact link hosts for JSON imports.
# SERIES_HONGGUO_HOSTS=
# SERIES_HANJUTV_HOSTS=
